# Copy to frontend/.env.local and fill in. Never commit .env.local.
# Everything here is PUBLIC (bundled into the browser) - never put secret keys here.

# Local: http://127.0.0.1:8000  ·  Render: https://<your-api-service>.onrender.com (no trailing slash).
# Production builds stop with an error if any of these three are missing.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
