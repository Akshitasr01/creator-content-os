# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Supabase (Project Settings -> API). Use the PUBLISHABLE key, never the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- AI provider
# "mock"   = free, clearly labelled demo output (no API key needed)
# "openai" = real AI generation (uses your OpenAI credits)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-key-here
# Model ID from https://platform.openai.com/docs/models - must support structured outputs
OPENAI_MODEL=your-model-id
OPENAI_TIMEOUT_SECONDS=90
# Optional: USD price per 1M tokens, used only for cost estimates in usage_events (0 = not tracked)
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0

# --- Free-beta limits
DAILY_AI_CALL_LIMIT=60
AI_REQUESTS_PER_MINUTE=10
SOURCE_MIN_CHARS=200
SOURCE_MAX_CHARS=30000
MAX_ASSETS_PER_REQUEST=8

# --- Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
